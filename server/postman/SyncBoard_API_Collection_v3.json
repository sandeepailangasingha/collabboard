{
  "info": {
    "_postman_id": "syncboard-api-v3-mongodb-atlas",
    "name": "SyncBoard / CollabBoard - Milestone 3 (MongoDB Atlas & Multiple Projects)",
    "description": "Comprehensive Postman REST API Collection for SyncBoard (CollabBoard) Full-Stack Team Kanban Application backed by Node.js, Express, Mongoose, and MongoDB Atlas Cloud Database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System Health",
      "item": [
        {
          "name": "GET API Health & Atlas Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Verifies Express server status, version 3.0.0, and active connection."
          }
        }
      ]
    },
    {
      "name": "2. Authentication Endpoints",
      "item": [
        {
          "name": "POST Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sandeepa Ilangasingha\",\n  \"email\": \"sandeepa@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"Lead Developer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Registers a new user in MongoDB Atlas and returns JWT bearer token."
          }
        },
        {
          "name": "POST Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sandeepa@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates user against MongoDB Atlas and returns a JWT token."
          }
        },
        {
          "name": "GET Current User Profile (JWT Protected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Validates JWT token and fetches current user document from MongoDB Atlas."
          }
        }
      ]
    },
    {
      "name": "3. Project Management Endpoints (Multi-Project)",
      "item": [
        {
          "name": "GET All Projects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects"
              ]
            },
            "description": "Fetches all project boards associated with the authenticated user."
          }
        },
        {
          "name": "POST Create New Project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mobile App \\u2014 Team Tracker\",\n  \"description\": \"React Native companion app for cross-platform team attendance.\",\n  \"color\": \"#10b981\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects"
              ]
            },
            "description": "Creates a new project document in MongoDB Atlas."
          }
        },
        {
          "name": "GET Single Project By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}"
              ]
            }
          }
        },
        {
          "name": "PUT Update Project",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mobile App \\u2014 Team Tracker (Updated)\",\n  \"description\": \"Updated project description.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}"
              ]
            }
          }
        },
        {
          "name": "DELETE Project (Cascade delete tasks)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}"
              ]
            },
            "description": "Deletes project and cascades deletion of all tasks under it."
          }
        }
      ]
    },
    {
      "name": "4. Task Management Endpoints",
      "item": [
        {
          "name": "GET Tasks (Filter by Project & Search)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks?projectId={{projectId}}&status=all&priority=all&search=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "projectId",
                  "value": "{{projectId}}"
                },
                {
                  "key": "status",
                  "value": "all"
                },
                {
                  "key": "priority",
                  "value": "all"
                },
                {
                  "key": "search",
                  "value": ""
                }
              ]
            },
            "description": "Retrieves tasks filtered by project, status, priority, and text search."
          }
        },
        {
          "name": "POST Create Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Configure Redis Caching Layer\",\n  \"description\": \"Implement in-memory cache for high-frequency database read queries.\",\n  \"status\": \"todo\",\n  \"priority\": \"high\",\n  \"assignee\": \"Sandeepa Ilangasingha\",\n  \"dueDate\": \"2026-09-15\",\n  \"tags\": [\n    \"Backend\",\n    \"Redis\"\n  ],\n  \"projectId\": \"{{projectId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "Creates a task in MongoDB Atlas assigned to a specific project."
          }
        },
        {
          "name": "PUT Update Task Status / Details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"done\",\n  \"priority\": \"high\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}"
              ]
            },
            "description": "Updates task status column (todo, doing, done) or priority/assignee."
          }
        },
        {
          "name": "DELETE Task",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}"
              ]
            },
            "description": "Deletes task from MongoDB Atlas."
          }
        }
      ]
    }
  ]
}