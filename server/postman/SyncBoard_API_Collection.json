		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"New Student\",\n  \"email\": \"student@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": { "raw": "http://localhost:5000/api/auth/register" }
					}
				},
				{
					"name": "Login User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"sandeepa@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": { "raw": "http://localhost:5000/api/auth/login" }
					}
				},
				{
					"name": "Get User Profile",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
						],
						"url": { "raw": "http://localhost:5000/api/auth/me" }
					}
				}
			]
		},
		{
			"name": "Tasks",
